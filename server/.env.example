# ============================================================================
# AI Resume Analyzer — Environment Variables
# Copy this file to `server/.env` and fill in the values you have.
# The app degrades gracefully: every section below is OPTIONAL except where
# noted. Missing keys simply disable that specific feature/source.
# ============================================================================

# --- Server ---
PORT=5001

# MongoDB connection string. If omitted (or left as the default local value),
# the server auto-starts an in-memory MongoDB for local dev — no install needed.
MONGO_URI=mongodb://127.0.0.1:27017/resume-analyzer

# Comma-separated list of origins allowed to call this API in production.
# Leave empty during local development to allow all origins.
# Example: CORS_ORIGINS=https://your-frontend.com,https://staging.your-frontend.com
CORS_ORIGINS=

# JWT signing secret — required for auth (login/register) to be secure.
JWT_SECRET=change-this-to-a-long-random-string

# ----------------------------------------------------------------------------
# AI narrative generation (resume summary, strengths/weaknesses wording,
# resume tailoring, cover letter generation). Skill matching and ATS scoring
# work fully deterministically WITHOUT this key — this only affects the
# written narrative and the "Tailor Resume" / "Cover Letter" features.
# Get a free key at: https://aistudio.google.com/app/apikey
# ----------------------------------------------------------------------------
GEMINI_API_KEY=

# ----------------------------------------------------------------------------
# Live job sources (Part 4). RemoteOK and Arbeitnow require NO key at all —
# these two work out of the box. Add any of the others you have access to —
# the app merges whichever sources are configured and skips the rest.
# ----------------------------------------------------------------------------

# Adzuna — https://developer.adzuna.com/  (free tier available; sign up for
# an app_id + app_key)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# Jooble — https://jooble.org/api/about  (request a free API key)
JOOBLE_API_KEY=

# Remotive — https://remotive.io/api-key (free, just needs your email —
# Remotive changed their API to require a key; it will not work without one)
REMOTIVE_API_KEY=

# Arbeitnow — no signup needed at all. Works automatically. EU/remote-focused.
# (nothing to fill in — listed here just so you know it's active)

# JSearch (RapidAPI) — https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Free tier available. This aggregates Google for Jobs results (which itself
# indexes LinkedIn/Indeed/Glassdoor listings) through a licensed third-party
# API — this is NOT us scraping those sites directly.
RAPIDAPI_KEY=

# USAJobs (U.S. federal government listings) — https://developer.usajobs.gov/
# Requires an API key AND the email you registered with, sent as the
# User-Agent header on every request (per USAJobs' API rules).
USAJOBS_API_KEY=
USAJOBS_USER_AGENT_EMAIL=

# SerpAPI (optional aggregator for Google Jobs results) —
# https://serpapi.com/ (free trial credits, paid after)
SERPAPI_KEY=
